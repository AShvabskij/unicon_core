# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Log files
*.log

# Package files
*.jar

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

